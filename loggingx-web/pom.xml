<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.loggingx</groupId>
        <artifactId>loggingx-java</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>loggingx-web</artifactId>
    <name>loggingx-web</name>
    <!-- Deployed to an external Tomcat as a WAR; spring-boot:run and java -jar still use the embedded Tomcat. -->
    <packaging>war</packaging>
    <dependencies>
        <dependency>
            <groupId>com.loggingx</groupId>
            <artifactId>loggingx-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.loggingx</groupId>
            <artifactId>loggingx-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.loggingx</groupId>
            <artifactId>loggingx-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.loggingx</groupId>
            <artifactId>loggingx-thirdparty</artifactId>
        </dependency>
        <dependency>
            <groupId>com.loggingx</groupId>
            <artifactId>loggingx-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Provided by the external Tomcat; kept on the classpath for spring-boot:run and in WEB-INF/lib-provided. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat-runtime</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Boot's servlet support, needed in an external Tomcat too; declared so the provided starter above,
             which also depends on it, does not take it out of WEB-INF/lib. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Consumes logs that collector agents publish to Kafka; off unless loggingx.log.kafka.enabled is true. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- An embedded Kafka broker for the Kafka ingestion test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Integration tests use an in-memory H2 database in MySQL mode, see src/test/resources/config. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Integration tests use an in-process Redis server, see TestRedisConfiguration. -->
        <dependency>
            <groupId>com.github.fppt</groupId>
            <artifactId>jedis-mock</artifactId>
        </dependency>
    </dependencies>
    <build>
        <!-- Tomcat derives the context path from the file name: loggingx.war is served at /loggingx. -->
        <finalName>loggingx</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
