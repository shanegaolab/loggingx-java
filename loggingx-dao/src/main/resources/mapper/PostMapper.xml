<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.loggingx.dao.post.PostMapper">

    <resultMap id="post" type="com.loggingx.dao.post.Post">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="sort" javaType="_int"/>
            <arg column="enabled" javaType="_boolean"/>
            <arg column="remark" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, code, name, sort, enabled, remark, created_at, updated_at
    </sql>

    <select id="selectAll" resultMap="post">
        SELECT <include refid="columns"/> FROM sys_post ORDER BY id
    </select>

    <select id="selectById" resultMap="post">
        SELECT <include refid="columns"/> FROM sys_post WHERE id = #{id}
        <if test="forUpdate">FOR UPDATE</if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="key.id" keyColumn="id">
        INSERT INTO sys_post (code, name, sort, enabled, remark, created_at, updated_at)
        VALUES (#{post.code}, #{post.name}, #{post.sort}, #{post.enabled}, #{post.remark}, #{post.createdAt},
                #{post.updatedAt})
    </insert>

    <update id="update">
        UPDATE sys_post
        SET code       = #{post.code},
            name       = #{post.name},
            sort       = #{post.sort},
            enabled    = #{post.enabled},
            remark     = #{post.remark},
            created_at = #{post.createdAt},
            updated_at = #{post.updatedAt}
        WHERE id = #{post.id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_post WHERE id = #{id}
    </delete>

    <select id="selectDeptLinks" resultType="com.loggingx.dao.support.Link">
        SELECT post_id AS owner_id, dept_id AS member_id FROM sys_post_dept
        <where>
            <if test="postIds != null">
                post_id IN <foreach collection="postIds" item="postId" open="(" separator="," close=")">#{postId}</foreach>
            </if>
        </where>
    </select>

    <delete id="deleteDeptLinks">
        DELETE FROM sys_post_dept
        WHERE post_id = #{postId}
          AND dept_id IN <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">#{deptId}</foreach>
    </delete>

    <insert id="insertDeptLinks">
        INSERT INTO sys_post_dept (post_id, dept_id) VALUES
        <foreach collection="deptIds" item="deptId" separator=",">(#{postId}, #{deptId})</foreach>
    </insert>

    <select id="existsForDept" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM sys_post_dept WHERE dept_id = #{deptId})
    </select>
</mapper>
