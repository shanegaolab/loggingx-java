<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.loggingx.dao.role.RoleMapper">

    <resultMap id="role" type="com.loggingx.dao.role.Role">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="enabled" javaType="_boolean"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, code, name, description, enabled, created_at, updated_at
    </sql>

    <select id="selectAll" resultMap="role">
        SELECT <include refid="columns"/> FROM sys_role ORDER BY id
    </select>

    <select id="selectById" resultMap="role">
        SELECT <include refid="columns"/> FROM sys_role WHERE id = #{id}
        <if test="forUpdate">FOR UPDATE</if>
    </select>

    <select id="selectByCode" resultMap="role">
        SELECT <include refid="columns"/> FROM sys_role WHERE code = #{code}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="key.id" keyColumn="id">
        INSERT INTO sys_role (code, name, description, enabled, created_at, updated_at)
        VALUES (#{role.code}, #{role.name}, #{role.description}, #{role.enabled}, #{role.createdAt},
                #{role.updatedAt})
    </insert>

    <update id="update">
        UPDATE sys_role
        SET code        = #{role.code},
            name        = #{role.name},
            description = #{role.description},
            enabled     = #{role.enabled},
            created_at  = #{role.createdAt},
            updated_at  = #{role.updatedAt}
        WHERE id = #{role.id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_role WHERE id = #{id}
    </delete>

    <select id="selectMenuLinks" resultType="com.loggingx.dao.support.Link">
        SELECT role_id AS owner_id, menu_id AS member_id FROM sys_role_menu
        <where>
            <if test="roleIds != null">
                role_id IN <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">#{roleId}</foreach>
            </if>
        </where>
    </select>

    <delete id="deleteMenuLinks">
        DELETE FROM sys_role_menu
        WHERE role_id = #{roleId}
          AND menu_id IN <foreach collection="menuIds" item="menuId" open="(" separator="," close=")">#{menuId}</foreach>
    </delete>

    <insert id="insertMenuLinks">
        INSERT INTO sys_role_menu (role_id, menu_id) VALUES
        <foreach collection="menuIds" item="menuId" separator=",">(#{roleId}, #{menuId})</foreach>
    </insert>
</mapper>
